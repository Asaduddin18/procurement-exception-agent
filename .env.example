# Optional overrides for the local Compose evaluator demo.
POSTGRES_PASSWORD=procurement
MCP_DB_PASSWORD=procurement_mcp
POSTGRES_PORT=5432
API_PORT=8000
FRONTEND_PORT=3000

# Demo extraction recognizes the two bundled PDFs by SHA-256.
# For live extraction, set the provider to deepseek and supply OPENAI_API_KEY.
PROCUREMENT_EXTRACTION_PROVIDER=fixture
# OPENAI_API_KEY=...
MCP_EMBEDDING_PROVIDER=fixture
# MCP_OPENAI_API_KEY=...
DEMO_POLICY_AS_OF=2026-10-19

DEMO_REVIEWER_TOKEN=demo-procurement-reviewer
DEMO_FINANCE_TOKEN=demo-finance-director
# REVIEWER_CREDENTIALS_JSON={"operator":{"role":"PROCUREMENT_REVIEWER","token":"replace-with-a-random-token"}}
# INGEST_WEBHOOK_TOKEN=...
# LANGFUSE_PUBLIC_KEY=...
# LANGFUSE_SECRET_KEY=...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_PROJECT_ID=...

# Optional host-process settings when running components outside Compose:
# DATABASE_URL=postgresql://procurement:procurement@127.0.0.1:5432/procurement
# MCP_DATABASE_URL=postgresql://procurement_mcp:procurement_mcp@127.0.0.1:5432/procurement
# MCP_SERVER_URL=http://127.0.0.1:8001/mcp
# PROCUREMENT_API_URL=http://127.0.0.1:8000

# QuickBooks Online US sandbox development credentials.
# QBO_CLIENT_ID=
# QBO_CLIENT_SECRET=
# QBO_REDIRECT_URI=http://localhost:8765/qbo/callback
# QBO_REALM_ID=
