# Local Compose defaults. Supply deployment credentials through the environment.
POSTGRES_PASSWORD=procurement
POSTGRES_PORT=5432
DATABASE_URL=postgresql://procurement:procurement@127.0.0.1:5432/procurement

# Export these after provisioning the dedicated role. Replace the local example password.
MCP_DATABASE_URL=postgresql://procurement_mcp:procurement_mcp@127.0.0.1:5432/procurement
MCP_EMBEDDING_PROVIDER=fixture
# MCP_OPENAI_API_KEY=...

# Phase 3 generation. Set this to your DeepSeek key for the OpenAI-compatible adapter.
# OPENAI_API_KEY=...
# Set a shared token to enable the JSON email webhook.
# INGEST_WEBHOOK_TOKEN=...

# Phase 4 review worker and reviewer API.
MCP_SERVER_URL=http://127.0.0.1:8001/mcp
# REVIEWER_CREDENTIALS_JSON={"operator":{"role":"PROCUREMENT_REVIEWER","token":"replace-with-a-random-token"}}
# LANGFUSE_PUBLIC_KEY=...
# LANGFUSE_SECRET_KEY=...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_PROJECT_ID=...

# Control Tower server-only configuration (frontend/.env.local).
PROCUREMENT_API_URL=http://127.0.0.1:8000
